<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="SceneScribe.Views.Dialogs.NameOnlyDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SceneScribe.Views.Dialogs"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    
    IsPrimaryButtonEnabled="False">

    <ContentDialog.Resources>
        <Style TargetType="local:NameOnlyDialog" BasedOn="{StaticResource DefaultContentDialogStyle}" />
    </ContentDialog.Resources>

    <TextBox x:Name="txtName"
             Text="{x:Bind DefaultText}"
             PlaceholderText="{x:Bind Placeholder}"
             MinWidth="475"
             MaxWidth="475"
             FontSize="16"
             TextWrapping="NoWrap"
             IsSpellCheckEnabled="True"
             IsTextPredictionEnabled="False"
             TextChanged="txtName_TextChanged" />
</ContentDialog>
