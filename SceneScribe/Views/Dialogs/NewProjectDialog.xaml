<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="SceneScribe.Views.Dialogs.NewProjectDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SceneScribe.Views.Dialogs"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    
    x:Uid="NewProjectDialog"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="False">

    <ContentDialog.Resources>
        <Style TargetType="local:NewProjectDialog" BasedOn="{StaticResource DefaultContentDialogStyle}" />
    </ContentDialog.Resources>

    <Grid RowSpacing="10" ColumnSpacing="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBox x:Name="txtProjectName"
                 x:Uid="NewProjectDialog_TextBoxProjectName"
                 MinWidth="475"
                 MaxWidth="475"
                 FontSize="16"
                 TextWrapping="NoWrap"
                 IsSpellCheckEnabled="True"
                 IsTextPredictionEnabled="False"
                 TextChanged="txtProjectName_TextChanged"
                 Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" />

        <TextBox x:Name="txtProjectFilePath"
                 IsReadOnly="True"
                 Foreground="{StaticResource TextBoxDisabledForegroundThemeBrush}"
                 MinWidth="436"
                 MaxWidth="436"
                 TextChanged="txtProjectFilePath_TextChanged"
                 Grid.Row="1" Grid.Column="0" />
        <Button x:Uid="NewProjectDialog_ButtonFolderPicker"
                Content="..."
                Click="FolderPicker_Click"
                Grid.Row="1" Grid.Column="1" />
    </Grid>
</ContentDialog>
