<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SceneScribe.Views.GroupBrowser"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SceneScribe.Views"
    xmlns:engine="using:SceneScribe.Engine"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <ScrollView VerticalScrollChainMode="Always"
                HorizontalScrollMode="Disabled">
        <StackPanel Spacing="50"
                    Padding="30">
            <ListView x:Name="GroupsListView"
                      ItemsSource="{x:Bind ViewModel.ActiveGroup.Groups}"
                      SelectionMode="None"
                      ScrollViewer.IsVerticalScrollChainingEnabled="True"
                      ScrollViewer.VerticalScrollMode="Disabled">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <controls:WrapPanel Orientation="Horizontal"
                                            HorizontalSpacing="20"
                                            VerticalSpacing="20" />
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="engine:SceneScribeGroup">
                        <HyperlinkButton Click="Group_Click"
                                         Tag="{x:Bind ID}">

                            <HyperlinkButton.ContextFlyout>
                                <CommandBarFlyout ShowMode="Standard">
                                    <CommandBarFlyout.SecondaryCommands>
                                        <AppBarButton x:Uid="AppBarButtonRenameGroup"
                                                      Icon="Edit"
                                                      Tag="{x:Bind ID}"
                                                      Click="RenameGroup_Click" />
                                        <AppBarSeparator />
                                        <AppBarButton x:Uid="AppBarButtonRemoveGroup"
                                                      Icon="Delete"
                                                      Tag="{x:Bind ID}"
                                                      Click="RemoveGroup_Click"/>
                                    </CommandBarFlyout.SecondaryCommands>
                                </CommandBarFlyout>
                            </HyperlinkButton.ContextFlyout>

                            <StackPanel Width="200"
                                        HorizontalAlignment="Center"
                                        Spacing="5">

                                <Canvas Background="Yellow"
                                        Width="200"
                                        Height="150" />

                                <TextBlock Text="{x:Bind Name}"
                                            HorizontalAlignment="Center"
                                            FontSize="12"
                                            TextWrapping="Wrap"
                                            TextTrimming="CharacterEllipsis"
                                            MaxLines="2" />
                            </StackPanel>
                        </HyperlinkButton>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <ListView x:Name="ProjectsListView"
                      ItemsSource="{x:Bind ViewModel.ActiveGroup.Projects}"
                      SelectionMode="None"
                      ScrollViewer.IsVerticalScrollChainingEnabled="True"
                      ScrollViewer.VerticalScrollMode="Disabled">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <controls:WrapPanel Orientation="Horizontal"
                                            HorizontalSpacing="20"
                                            VerticalSpacing="20" />
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="engine:SceneScribeProject">
                        <HyperlinkButton Click="Project_Click"
                                         Tag="{x:Bind ID}">

                            <HyperlinkButton.ContextFlyout>
                                <CommandBarFlyout ShowMode="Standard">
                                    <CommandBarFlyout.SecondaryCommands>
                                        <AppBarButton x:Uid="AppBarButtonRenameProject"
                                                      Icon="Edit"
                                                      Tag="{x:Bind ID}"
                                                      Click="RenameProject_Click" />
                                        <AppBarSeparator />
                                        <AppBarButton x:Uid="AppBarButtonRemoveProject"
                                                      Icon="Delete"
                                                      Tag="{x:Bind ID}"
                                                      Click="RemoveProject_Click" />
                                    </CommandBarFlyout.SecondaryCommands>
                                </CommandBarFlyout>
                            </HyperlinkButton.ContextFlyout>

                            <StackPanel Width="200"
                                        HorizontalAlignment="Center"
                                        Spacing="5">

                                <Canvas Background="White"
                                        Width="170"
                                        Height="220" />

                                <TextBlock Text="{x:Bind Name}"
                                           HorizontalAlignment="Center"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           TextTrimming="CharacterEllipsis"
                                           Height="35"
                                           MaxLines="2" />
                            </StackPanel>
                        </HyperlinkButton>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </ScrollView>
</Page>
